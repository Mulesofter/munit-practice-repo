            <munit-tools:assert-that
                doc:name="Assert Customer Status"
                doc:id="fbf6b515-3c47-49a6-ab40-ee77b41aecb9"
                expression="#[payload.customerStatus]"
                is="#[MunitTools::equalTo('INACTIVE')]"/>

            <munit-tools:verify-call
                doc:name="Verify Salesforce Query"
                doc:id="c63e4052-76e3-4c2c-9011-aa8eeb04c6df"
                processor="salesforce:query">

                <munit-tools:with-attributes>

                    <munit-tools:with-attribute
                        whereValue="Query"
                        attributeName="doc:name"/>

                </munit-tools:with-attributes>

            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>


    <munit:test
        name="Account-Summary-Insert-Success"
        doc:id="c02b68fb-5ae7-48db-a186-7d3a9c6ae317">

        <munit:behavior>

            <munit-tools:mock-when
                doc:name="Mock DB Insert"
                doc:id="c88ee802-61cc-4ed3-9f2e-db044777ec53"
                processor="db:insert">

                <munit-tools:with-attributes>

                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Insert Account Summary"/>

                </munit-tools:with-attributes>

            </munit-tools:mock-when>


            <munit-tools:spy
                doc:name="Spy Validate Input"
                doc:id="efe178f1-72ed-46a6-a9a0-c936ba6254ec"
                processor="ee:transform">

                <munit-tools:with-attributes>

                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Validate Input"/>

                </munit-tools:with-attributes>

                <munit-tools:after-call>

                    <munit-tools:assert-that
                        doc:name="Assert Account ID"
                        doc:id="bbf4ebd5-498f-46e5-8246-215528a4c62d"
                        is="#[MunitTools::equalTo('A1011')]"
                        expression="#[payload.account_id]"/>

                    <munit-tools:assert-that
                        doc:name="Assert Customer ID"
                        doc:id="578d10cd-921c-403b-9510-d5a76abe4bfa"
                        is="#[MunitTools::equalTo('C1011')]"
                        expression="#[payload.customer_id]"/>

                    <munit-tools:assert-that
                        doc:name="Assert Client ID"
                        doc:id="979332db-9427-4940-8530-281ad7cc190b"
                        is="#[MunitTools::equalTo('C1011')]"
                        expression="#[payload.client_id]"/>

                </munit-tools:after-call>

            </munit-tools:spy>

        </munit:behavior>


        <munit:execution>

            <munit:set-event
                doc:name="Set Event Input"
                doc:id="f9100fde-b8bc-4ed5-80d9-3b6fbf4d60c2">

                <munit:payload value="#[{
                    account_id: 'A1011',
                    customer_id: 'C1011',
                    client_id: 'C1011',
                    plan_type: '401K',
                    plan_name: 'Retirement Plan',
                    balance: 50000,
                    settled_balance: 48000,
                    vested_balance: 45000,
                    available_for_withdrawal: 20000,
                    currency: 'USD',
                    status: 'ACTIVE',
                    tax_year: 2026
                }]"/>

            </munit:set-event>

            <flow-ref
                doc:name="Execute MQ-Decoupl"
                doc:id="3e645da5-a17b-4bad-9375-8686d815c4e7"
                name="MQ-Decoupl"/>

        </munit:execution>


        <munit:validation>

            <munit-tools:assert-that
                doc:name="Assert Final Message"
                doc:id="ccea88ec-be92-4a4a-a27c-1a31825b8c02"
                is="#[MunitTools::equalTo('new record inserted')]"
                expression="#[payload.message]"/>

            <munit-tools:assert-that
                doc:name="Assert Final Payload"
                doc:id="76a9a03a-1dc2-4984-80de-8e8d8f161c68"
                is="#[MunitTools::equalTo('newRecord')]"
                expression="#[payload.payload]"/>

            <munit-tools:verify-call
                processor="db:insert"
                times="1"
                doc:name="Verify DB Insert">

                <munit-tools:with-attributes>

                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="Insert Account Summary"/>

                </munit-tools:with-attributes>

            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>

</mule>