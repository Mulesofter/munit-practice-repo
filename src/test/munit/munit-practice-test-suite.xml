<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

    <munit:config name="munit-practice-test-suite.xml"/>

<munit:test
    name="Success-Customer-Lookup"
    description="Test successful customer lookup from database">

    <munit:behavior>

        <munit-tools:mock-when
            processor="db:select"
            doc:name="Mock DB Select">

            <munit-tools:with-attributes>

                <munit-tools:with-attribute
                    attributeName="doc:name"
                    whereValue="Select By ID"/>

            </munit-tools:with-attributes>

            <munit-tools:then-return>

                <munit-tools:payload value="#[[
                    {
                        account_id: 'A1001',
                        customer_id: 'C1001',
                        plan_type: '401K',
                        plan_name: 'Retirement Plan',
                        balance: 50000,
                        settled_balance: 48000,
                        vested_balance: 45000,
                        available_for_withdrawal: 20000,
                        currency: 'USD',
                        status: 'ACTIVE',
                        tax_year: 2026
                    }
                ]]"/>

            </munit-tools:then-return>

        </munit-tools:mock-when>

    </munit:behavior>

    <munit:execution>

        <munit:set-event doc:name="Set Event Input">

            <munit:attributes value="#[
                {
                    uriParams: {
                        customerId: 'C1001'
                    }
                }
            ]"/>

        </munit:set-event>

        <flow-ref
            name="DB-Lookup"
            doc:name="Call DB-Lookup"/>

    </munit:execution>

    <munit:validation>

        <munit-tools:assert-that
            expression="#[payload[0].account_id]"
            is="#[MunitTools::equalTo('A1001')]"
            doc:name="Assert Account ID"/>

        <munit-tools:assert-that
            expression="#[payload[0].balance]"
            is="#[MunitTools::equalTo(50000)]"
            doc:name="Assert Balance"/>

        <munit-tools:assert-that
            expression="#[payload[0].status]"
            is="#[MunitTools::equalTo('ACTIVE')]"
            doc:name="Assert Status"/>

        <munit-tools:assert-that
            expression="#[payload[0].tax_year]"
            is="#[MunitTools::equalTo(2026)]"
            doc:name="Assert Tax Year"/>

        <munit-tools:verify-call
            processor="db:select"
            doc:name="Verify DB Select Was Called">

            <munit-tools:with-attributes>

                <munit-tools:with-attribute
                    attributeName="doc:name"
                    whereValue="Select By ID"/>

            </munit-tools:with-attributes>

        </munit-tools:verify-call>

    </munit:validation>

</munit:test>


    <munit:test
        name="SalesforceChoice-ACTIVE"
        doc:id="008cc7f9-11d0-4b38-b04d-bfd51b294ee9">

        <munit:behavior>

            <!-- MOCK SALESFORCE -->

            <munit-tools:mock-when
                doc:name="Mock SF Query"
                doc:id="08d77b9a-6dad-44be-aba1-83725f2bd9ac"
                processor="salesforce:query">

                <munit-tools:with-attributes>

                    <munit-tools:with-attribute
                        whereValue="Query"
                        attributeName="doc:name"/>

                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:payload value="#[[
                        {
                            Customer_ID__c: 'C1010',
                            First_Name__c: 'John',
                            Last_Name__c: 'Smith',
                            Email__c: 'john.smith@example.com',
                            Phone__c: '555-123-4567',
                            Date_of_Birth__c: '1980-05-15',
                            SSN_Last_4__c: '1234',
                            Address_Line_1__c: '123 Main Street',
                            City__c: 'Richmond',
                            State__c: 'VA',
                            Postal_Code__c: '23220',
                            Status__c: 'ACTIVE'
                        }
                    ]]"/>

                </munit-tools:then-return>

            </munit-tools:mock-when>


            <!-- SPY SALESFORCE -->

            <munit-tools:spy
                doc:name="Spy SF Query"
                doc:id="a5dbac49-8f46-43dc-964d-fda4a28b048a"
                processor="salesforce:query">

                <munit-tools:with-attributes>

                    <munit-tools:with-attribute
                        whereValue="Query"
                        attributeName="doc:name"/>

                </munit-tools:with-attributes>

                <munit-tools:before-call>

                    <!-- CHECK WHAT IS GOING INTO SALESFORCE -->

                    <munit-tools:assert-that
                        doc:name="Verify Customer ID"
                        expression="#[attributes.uriParams.customerId]"
                        is="#[MunitTools::equalTo('C1010')]"/>

                </munit-tools:before-call>

            </munit-tools:spy>

        </munit:behavior>


        <!-- EXECUTION -->

        <munit:execution>

            <munit:set-event
                doc:name="Set Event"
                doc:id="28929882-48c5-46d7-8428-3a6a1d92d7be">

                <munit:attributes
                    value="#[{
                        uriParams: {
                            customerId: 'C1010'
                        }
                    }]"/>

            </munit:set-event>

            <flow-ref
                doc:name="Call SF-Check"
                doc:id="2bfe0de3-2bf0-41b0-8478-d8f20bde41f5"
                name="SF-Check"/>

        </munit:execution>


        <!-- VALIDATION -->

        <munit:validation>

            <!-- FINAL OUTPUT -->

            <munit-tools:assert-that
                doc:name="Assert Customer ID"
                expression="#[payload[0].CustomerID]"
                is="#[MunitTools::equalTo('C1010')]"/>

            <munit-tools:assert-that
                doc:name="Assert Full Name"
                expression="#[payload[0].FullName]"
                is="#[MunitTools::equalTo('John Smith')]"/>

            <munit-tools:assert-that
                doc:name="Assert Email"
                expression="#[payload[0].Email]"
                is="#[MunitTools::equalTo('john.smith@example.com')]"/>

            <munit-tools:assert-that
                doc:name="Assert Status"
                expression="#[payload[0].Status]"
                is="#[MunitTools::equalTo('ACTIVE')]"/>


            <!-- VERIFY SALESFORCE WAS CALLED -->

            <munit-tools:verify-call
                doc:name="Verify Salesforce Query"
                doc:id="dbc04348-27c2-4de8-95df-97c31ee10488"
                processor="salesforce:query">

                <munit-tools:with-attributes>

                    <munit-tools:with-attribute
                        whereValue="Query"
                        attributeName="doc:name"/>

                </munit-tools:with-attributes>

            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>


    <munit:test
        name="SalesforceChoice-INACTIVE"
        doc:id="3649db70-3797-4cf4-8bcb-e372f3470888">

        <munit:behavior>

            <munit-tools:mock-when
                doc:name="Mock SF Query"
                doc:id="52c9ad3e-2d3e-4d29-a202-d2c20ad9ece2"
                processor="salesforce:query">

                <munit-tools:with-attributes>

                    <munit-tools:with-attribute
                        whereValue="Query"
                        attributeName="doc:name"/>

                </munit-tools:with-attributes>

                <munit-tools:then-return>

                    <munit-tools:payload value="#[[
                        {
                            Customer_ID__c: 'C1010',
                            First_Name__c: 'John',
                            Last_Name__c: 'Smith',
                            Email__c: 'john.smith@example.com',
                            Phone__c: '555-123-4567',
                            Date_of_Birth__c: '1980-01-01',
                            SSN_Last_4__c: '1234',
                            Address_Line_1__c: '123 Main St',
                            City__c: 'Richmond',
                            State__c: 'VA',
                            Postal_Code__c: '23219',
                            Status__c: 'INACTIVE'
                        }
                    ]]"/>

                </munit-tools:then-return>

            </munit-tools:mock-when>


            <munit-tools:spy
                doc:name="Spy SF Query"
                doc:id="3fe9f61f-9200-4c83-a239-f0c8e538c5a3"
                processor="salesforce:query">

                <munit-tools:with-attributes>

                    <munit-tools:with-attribute
                        whereValue="Query"
                        attributeName="doc:name"/>

                </munit-tools:with-attributes>

                <munit-tools:before-call>

                    <munit-tools:assert-that
                        doc:name="Verify Customer ID"
                        doc:id="68860848-6516-4099-bb2a-cf5d06ddff5e"
                        expression="#[attributes.uriParams.customerId]"
                        is="#[MunitTools::equalTo('C1010')]"/>

                </munit-tools:before-call>

            </munit-tools:spy>

        </munit:behavior>


        <munit:execution>

            <munit:set-event
                doc:name="Set Event"
                doc:id="dc3045c0-93cd-4748-ae22-deda110d8fa2">

                <munit:attributes value="#[{
                    uriParams: {
                        customerId: 'C1010'
                    }
                }]"/>

            </munit:set-event>

